#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Out { double v[]; } o;
layout(push_constant) uniform PC { int K; } pc;
void main() {
  dvec2 a = dvec2(1.0001), b = dvec2(0.9999), c = dvec2(0.5);
  for (int i = 0; i < pc.K; i++) {
    a = a * b + c; b = b * a + c;
  }
  if (gl_GlobalInvocationID.x == 0u) { o.v[0] = a.x + a.y + b.x; }
}
