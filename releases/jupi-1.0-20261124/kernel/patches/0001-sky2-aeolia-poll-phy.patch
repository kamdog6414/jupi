+static bool sky2_aeolia_phy_poll(const struct sky2_hw *hw)
+{
+	return aeolia_poll_phy && hw->ports == 1 &&
+	       hw->pdev->vendor == PCI_VENDOR_ID_SONY &&
+	       hw->pdev->device == PCI_DEVICE_ID_SONY_AEOLIA_GBE &&
+	       (hw->flags & SKY2_HW_USE_AEOLIA_MSI);
+}
+
+static u32 sky2_port_irq_mask(const struct sky2_hw *hw, unsigned int port)
+{
+	u32 mask = portirq_msk[port];
+
+	if (!port && sky2_aeolia_phy_poll(hw))
+		mask &= ~Y2_IS_IRQ_PHY1;
+	return mask;
+}
+
+/* Call after NAPI is disabled so a PHY event cannot rearm the timer. */
+static void sky2_aeolia_stop_phy_poll(struct sky2_hw *hw)
+{
+	if (!sky2_aeolia_phy_poll(hw))
+		return;
+
+	timer_delete_sync(&hw->watchdog_timer);
+	clear_bit(0, &hw->phy_poll_pending);
+}
