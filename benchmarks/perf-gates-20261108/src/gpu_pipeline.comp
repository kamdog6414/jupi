#version 450
// Every invocation consumes a different stored sample and stores its result.
// NoContraction preserves the float32 recurrence used by the CPU reference.
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Samples { float v[]; } samples;
layout(push_constant) uniform Params {
    uint count;
    uint first;
    uint steps;
    float gain;
    float offset;
} p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.count) return;
    precise float x = samples.v[i];
    for (uint s = p.first; s < p.first + p.steps; ++s) {
        precise float bias = p.offset * float(s + 1u);
        x = x * p.gain + bias;
    }
    samples.v[i] = x;
}
