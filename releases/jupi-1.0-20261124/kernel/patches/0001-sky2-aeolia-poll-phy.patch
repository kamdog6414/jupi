+static int sky2_autoneg_done(struct sky2_port *sky2, u16 aux)
+{
+	struct sky2_hw *hw = sky2->hw;
+	unsigned int port = sky2->port;
+	u16 advert = gm_phy_read(hw, port, PHY_MARV_AUNE_ADV);
+	u16 lpa = gm_phy_read(hw, port, PHY_MARV_AUNE_LP);
+
+	return sky2_resolve_autoneg(sky2, aux, advert, lpa);
+}
+
+/* Carrier must recover even when the masked PHY interrupt has no latch. */
+static void sky2_phy_poll(struct sky2_hw *hw)
+{
+	struct net_device *dev = hw->dev[0];
+	struct sky2_port *sky2 = netdev_priv(dev);
+	u16 events, status, basic, advert, lpa;
+	bool carrier;
+
+	if (!netif_running(dev))
+		return;
+
+	spin_lock(&sky2->phy_lock);
+	/* Read the clear-on-read event latch, then sample the PHY's level. */
+	if (__gm_phy_read(hw, 0, PHY_MARV_INT_STAT, &events) ||
+	    __gm_phy_read(hw, 0, PHY_MARV_PHY_STAT, &status) ||
+	    events == 0xffff || status == 0xffff)
+		goto out;
+
+	carrier = netif_carrier_ok(dev);
+	if (!(status & PHY_M_PS_LINK_UP)) {
+		if (carrier)
+			sky2_link_down(sky2);
+		goto out;
+	}
+
+	if (sky2->flags & SKY2_FLAG_AUTO_SPEED) {
+		if (!(status & PHY_M_PS_SPDUP_RES))
+			goto out;
+		if (carrier && !(events & (PHY_M_IS_AN_COMPL | PHY_M_IS_LST_CHANGE |
+					   PHY_M_IS_LSP_CHANGE | PHY_M_IS_DUP_CHANGE)) &&
+		    sky2->speed == sky2_phy_speed(hw, status) &&
+		    sky2->duplex == ((status & PHY_M_PS_FULL_DUP) ? DUPLEX_FULL : DUPLEX_HALF))
+			goto out;
+		if (__gm_phy_read(hw, 0, PHY_MARV_STAT, &basic) ||
+		    __gm_phy_read(hw, 0, PHY_MARV_AUNE_ADV, &advert) ||
+		    __gm_phy_read(hw, 0, PHY_MARV_AUNE_LP, &lpa) ||
+		    basic == 0xffff || advert == 0xffff || lpa == 0xffff ||
+		    !(basic & PHY_ST_AN_OVER) ||
+		    sky2_resolve_autoneg(sky2, status, advert, lpa))
+			goto out;
+	} else if (carrier) {
+		goto out;
+	}
+
+	sky2_link_up(sky2);
+out:
+	spin_unlock(&sky2->phy_lock);
 }
 
