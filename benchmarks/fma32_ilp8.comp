#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Out { float v[]; } o;
layout(push_constant) uniform PC { int K; } pc;
void main() {
  vec4 c = vec4(0.5);
  vec4 a = vec4(1.0001), b = vec4(0.9999);
  vec4 a2 = vec4(1.0003), b2 = vec4(0.9997);
  vec4 a3 = vec4(1.0005), b3 = vec4(0.9995);
  vec4 a4 = vec4(1.0007), b4 = vec4(0.9993);
  vec4 a5 = vec4(1.0009), b5 = vec4(0.9991);
  vec4 a6 = vec4(1.0011), b6 = vec4(0.9989);
  vec4 a7 = vec4(1.0013), b7 = vec4(0.9987);
  vec4 a8 = vec4(1.0015), b8 = vec4(0.9985);
  for (int i = 0; i < pc.K; i++) {
    a = a * b + c; b = b * a + c;
    a2 = a2 * b2 + c; b2 = b2 * a2 + c;
    a3 = a3 * b3 + c; b3 = b3 * a3 + c;
    a4 = a4 * b4 + c; b4 = b4 * a4 + c;
    a5 = a5 * b5 + c; b5 = b5 * a5 + c;
    a6 = a6 * b6 + c; b6 = b6 * a6 + c;
    a7 = a7 * b7 + c; b7 = b7 * a7 + c;
    a8 = a8 * b8 + c; b8 = b8 * a8 + c;
  }
  if (gl_GlobalInvocationID.x == 0u) { o.v[0] = a.x + a2.y + a3.z + a4.w + a5.x + a6.y + a7.z + a8.w + b.x + b2.y + b3.z + b4.w + b5.x + b6.y + b7.z + b8.w; }
}
